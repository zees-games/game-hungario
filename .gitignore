# Godot 4
.godot/
/android/

# Every gs-* addon is a separate repository. For local development, symlink them:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# A shipped build copies them in instead.
/addons/gs_core
/addons/gs_profile
/addons/gs_profiler
/addons/gs_2d
# bootstrap fetches the release zip into addons/gs_net/native/bin and export copies it beside the exe (gs-bootstrap: bootstrap-natives).
# bootstrap-natives: gs-net v0.1.30 native/bin
/addons/gs_net
# gs-sim: optional native library (snapshot codec); without its built library the GDScript twins run.
# bootstrap-natives: gs-sim v0.2.10
/addons/gs_sim
/addons/gs_server
/addons/gs_match
